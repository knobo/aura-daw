# No trailing slashes below, deliberately, on everything a worktree is likely to
# SYMLINK at the main checkout instead of duplicating (target dirs, the npm
# install, the sidecar venv — gigabytes each on this box). `foo/` matches a
# DIRECTORY only, so a `foo` symlink stays untracked-but-visible and gets swept
# up by the next `git add -A`: that is exactly how the self-referential
# node_modules link in PR #65 landed and had to be removed again in PR #73.
# Without the slash, both shapes are ignored.

# Rust
/src-tauri/target
/benches/*/target

# Node
/node_modules
/dist/

# Python sidecar environment (local, machine-specific)
/.venv-sidecars

# Tauri
/src-tauri/gen/

# Claude Code: agent worktree checkouts are local scratch state (skills are tracked)
/.claude/worktrees/

# Feature worktrees cut from origin/main (CLAUDE.md). Same no-trailing-slash
# rule as the rest of this file: a `.worktrees` symlink must stay ignored.
/.worktrees

# Local project data / caches
*.wav.tmp
project.json.v1.bak

# Editors / OS
.DS_Store
*.swp
